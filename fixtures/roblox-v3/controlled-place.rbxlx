          <string name="Name">DecompilerV3Fixtures</string>
        </Properties>
        <Item class="LocalScript" referent="RBX00000012">
          <Properties>
            <string name="Name">LocalBinary</string>
            <ProtectedString name="Source"><![CDATA[return function(seed: number)
    warn("local", seed, "\000\255")
    return seed, "client local", nil
end
]]></ProtectedString>
            <bool name="Disabled">true</bool>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX00000013">
          <Properties>
            <string name="Name">LocalLoop</string>
            <ProtectedString name="Source"><![CDATA[return function(seed: number)
    local result = seed
    repeat
        result += 1
    until result >= seed + 3
    return result, nil, "repeat"
end
]]></ProtectedString>
            <bool name="Disabled">true</bool>
          </Properties>
        </Item>

      <Item class="ModuleScript" referent="RBX00000008">
        <Properties>
          <string name="Name">CaptureCounter</string>
          <ProtectedString name="Source"><![CDATA[local count = 0
return function(delta: number)
    count += delta
    return count, nil, "counter"
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX00000009">
        <Properties>
          <string name="Name">ClientMethods</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    local owned = Instance.new("Part")
    owned.Name = "DecompilerV3UnparentedPart"
    owned.Position = Vector3.new(seed, 2, 3)
    local position = owned:GetPivot().Position
    local class = owned.ClassName
    owned:Destroy()
    return position, class, nil
end
]]></ProtectedString>
          <bool name="Disabled">true</bool>
          <token name="RunContext">2</token>
        </Properties>
      </Item>

      <Item class="ModuleScript" referent="RBX00000014">
        <Properties>
          <string name="Name">LoopMutation</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    local values = { first = seed, second = seed + 1 }
    local alias = values
    local total = 0
    for index = 1, math.abs(seed) + 4 do
        if index == 4 then break end
        total += index
    end
    for _, value in { alias.first, alias.second } do
        total += value
    end
    alias.second = total
    return values.first, values.second, alias == values, nil
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000015">
        <Properties>
          <string name="Name">ModuleDependency</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    return seed * seed, nil
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000016">
        <Properties>
          <string name="Name">ModuleInterface</string>
          <ProtectedString name="Source"><![CDATA[local count = 0
local module = {}
function module.update(delta: number)
    count += delta
    return count, nil
end
function module.snapshot()
    return { count = count, version = 3 }
end
return module
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000017">
        <Properties>
          <string name="Name">OwnedMethods</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    local owned = Instance.new("Folder")
    owned.Name = "DecompilerV3OwnedProbe"
    owned:SetAttribute("Seed", seed)
    local value = owned:GetAttribute("Seed")
    local isFolder = owned:IsA("Folder")
    owned:Destroy()
    return value, isFolder, nil
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000018">
        <Properties>
          <string name="Name">ProtectedCalls</string>
          <ProtectedString name="Source"><![CDATA[local function inner(seed: number, ...)
    if seed < 0 then error("controlled\000\255", 0) end
    if seed == 0 then
        print("before yield")
        task.wait()
        print("after yield")
    end
    return seed, nil, ...
end
return function(seed: number)
    local function protected(...)
        return pcall(inner, seed, ...)
    end
    return pcall(protected, "tail", nil)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000019">
        <Properties>
          <string name="Name">RequireDependency</string>
          <ProtectedString name="Source"><![CDATA[local dependency = require(script.Parent.ModuleDependency)
return function(seed: number)
    local squared = dependency(seed)
    return squared + 1, nil
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000020">
        <Properties>
          <string name="Name">ScalarBinary</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    print("scalar", seed, "\000\255")
    return seed + 7, nil, "\128\000\254", seed == 0
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000021">
        <Properties>
          <string name="Name">VectorValues</string>
          <ProtectedString name="Source"><![CDATA[return function(seed: number)
    local value = Vector3.new(seed, 2, 3)
    local cross = value:Cross(Vector3.new(0, 1, 0))
    return value, cross, value.Magnitude, nil
end
]]></ProtectedString>
        </Properties>
      </Item>

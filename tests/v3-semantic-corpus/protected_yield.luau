local seed = ...
local thread = coroutine.create(function(...)
    return pcall(function(...)
        local resumed, trailing = coroutine.yield("pause", nil, ...)
        print("resumed", resumed, trailing)
        return resumed, nil, "complete", nil
    end, ...)
end)
local first = table.pack(coroutine.resume(thread, seed, nil, "start"))
print("yielded", first.n, table.unpack(first, 1, first.n))
local second = table.pack(coroutine.resume(thread, seed + 3, nil))
local direct = coroutine.create(function(...)
    return pcall(coroutine.yield, ...)
end)
local directFirst = table.pack(coroutine.resume(direct, "direct", nil, seed))
print("direct yield", directFirst.n, table.unpack(directFirst, 1, directFirst.n))
local directLast = table.pack(coroutine.resume(direct, seed + 5, nil))
print("direct resume", directLast.n, table.unpack(directLast, 1, directLast.n))
return second.n, table.unpack(second, 1, second.n)
